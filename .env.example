NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=myuser
DB_PASSWORD=mypassword
DB_DATABASE=mydatabase

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_TTL_TRACKING=600
REDIS_TTL_VIEW=3600
REDIS_TTL_MENU=86400

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=express-uploads
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/express-uploads

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Express Courier <noreply@example.com>"
CSKH_EMAIL=cskh@example.com

# reCAPTCHA v3
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Carrier APIs (sandbox)
DHL_API_KEY=
DHL_API_SECRET=
DHL_BASE_URL=https://api-mock.dhl.com

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_ACCOUNT_NUMBER=

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_BASE_URL=https://wwwcie.ups.com
UPS_ACCOUNT_NUMBER=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# CORS
CORS_ORIGIN=http://localhost:3000

# Seed admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Admin
